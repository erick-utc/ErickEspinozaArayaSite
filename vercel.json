{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/storybook",
      "destination": "/styleguide/",
      "permanent": true
    },
    {
      "source": "/storybook/:path*",
      "destination": "/styleguide/:path*",
      "permanent": true
    }
  ]
}
